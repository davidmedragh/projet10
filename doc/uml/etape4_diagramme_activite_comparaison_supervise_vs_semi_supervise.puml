@startuml etape4_diagramme_activite_comparaison_supervise_vs_semi_supervise
!theme plain

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ArrowColor #145A86
skinparam activityFontColor #0B2A45
skinparam activity {
  BackgroundColor #EAF6FF
  BorderColor #145A86
  DiamondBackgroundColor #FFF4DA
  DiamondBorderColor #C88B00
  StartColor #2E7D32
  EndColor #C62828
  BarColor #4A9EC9
}

title Etape 4 - Diagramme d'activite de la comparaison supervise pur vs semi-supervise
right footer David MEDRAGH projet10

start
:Recuperer results_A;
:Recuperer results_B;
:Comparer F1 macro;
:Comparer accuracy;
:Comparer recall cancer;
:Comparer precision cancer;
:Comparer les matrices de confusion;
if (Le semi-supervise apporte un gain sur recall cancer ?) then (Oui)
  :Valider l'interet de l'utilisation des pseudo-labels;
else (Non)
  :Documenter un benefice non demontre;
endif
:Formuler les limites (20 images test, resultat exploratoire);
:Conclure pour CurelyticsIA;
stop

@enduml
