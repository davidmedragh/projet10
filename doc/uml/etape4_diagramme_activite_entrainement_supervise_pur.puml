@startuml etape4_diagramme_activite_entrainement_supervise_pur
!theme plain

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ArrowColor #145A86
skinparam activityFontColor #0B2A45
skinparam activity {
  BackgroundColor #EAF6FF
  BorderColor #145A86
  DiamondBackgroundColor #FFF4DA
  DiamondBorderColor #C88B00
  StartColor #2E7D32
  EndColor #C62828
  BarColor #4A9EC9
}

title Etape 4 - Diagramme d'activite de l'entrainement supervise pur
right footer David MEDRAGH projet10

start
:Creer le modele A;
:Utiliser dl_train_strong (64 images);
:Boucler sur les epoques d'entrainement;
:Calculer train_loss a chaque epoque;
:Evaluer sur dl_val (16 images);
if (val_loss baisse ?) then (Oui)
  :Mettre a jour le meilleur modele;
else (Non)
  :Incrementer le compteur patience;
endif
if (Patience depassee ?) then (Oui)
  :Stopper l'entrainement;
else (Non)
  :Continuer les epoques;
endif
:Evaluer le meilleur modele A sur dl_test (20 images);
stop

@enduml
