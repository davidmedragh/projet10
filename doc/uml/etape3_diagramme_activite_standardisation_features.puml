@startuml etape3_diagramme_activite_standardisation_features
!theme plain

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ArrowColor #145A86
skinparam activityFontColor #0B2A45
skinparam activity {
  BackgroundColor #EAF6FF
  BorderColor #145A86
  DiamondBackgroundColor #FFF4DA
  DiamondBorderColor #C88B00
  StartColor #2E7D32
  EndColor #C62828
  BarColor #4A9EC9
}

title Etape 3 - Diagramme d'activite de la standardisation des features
right footer David MEDRAGH projet10

start
:Charger la matrice features.npy;
:Verifier la shape (1506, 2048);
if (Shape attendue ?) then (Oui)
  :Appliquer StandardScaler sur les 2 048 dimensions;
else (Non)
  :Arreter l'etape et documenter l'anomalie;
  stop
endif
:Calculer la mean et l'ecart-type apres transformation;
if (mean ≈ 0 et std ≈ 1 ?) then (Oui)
  :Valider features_scaled;
else (Non)
  :Investiguer les colonnes anormales;
endif
:Transmettre features_scaled a PCA, t-SNE et clustering;
stop

@enduml
