@startuml etape1_diagramme_activite_controle_qualite
!theme plain

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ArrowColor #1A5C8A
skinparam activityFontColor #0B2A45
skinparam activity {
  BackgroundColor #EAF6FF
  BorderColor #1A5C8A
  DiamondBackgroundColor #FFF4DA
  DiamondBorderColor #C88B00
  StartColor #2E7D32
  EndColor #C62828
  BarColor #4A9EC9
}

title Etape 1 - Diagramme d'activite du controle qualite
right footer David MEDRAGH projet10

start
repeat
  :Selectionner le prochain fichier image;
  :Ouvrir l'image avec PIL;
  if (Image lisible ?) then (Oui)
    :Lire le format, les dimensions et le mode;
    if (Format attendu ?) then (Oui)
      if (Dimensions attendues ?) then (Oui)
        if (Mode couleur attendu ?) then (Oui)
          :Classer l'image comme valide;
        else (Non)
          :Signaler une anomalie de mode couleur;
        endif
      else (Non)
        :Signaler une anomalie de dimensions;
      endif
    else (Non)
      :Signaler une anomalie de format;
    endif
  else (Non)
    :Signaler une image corrompue ou illisible;
  endif
  :Enregistrer le resultat dans le tableau de controle;
repeat while (Images restantes ?) is (Oui)
:Consolider les anomalies par dossier;
:Produire la synthese de qualite du dataset;
stop

@enduml
