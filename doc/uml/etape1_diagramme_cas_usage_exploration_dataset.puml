@startuml etape1_diagramme_cas_usage_exploration_dataset
!theme plain
left to right direction

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ArrowColor #1A5C8A
skinparam actor {
  BorderColor #C88B00
  BackgroundColor #FFF4DA
  FontColor #5C4300
}
skinparam usecase {
  BorderColor #1A5C8A
  BackgroundColor #EAF6FF
  FontColor #0B2A45
}
skinparam rectangle {
  BorderColor #1A5C8A
  BackgroundColor #F7FBFD
  FontColor #0B2A45
}

title Etape 1 - Diagramme de cas d'usage de l'exploration du dataset
right footer David MEDRAGH projet10

actor "Data Scientist junior" as ds

rectangle "Etape 1 - Explorer le jeu de donnees" {
  usecase "Inventorier les sous-dossiers" as uc_inventory
  usecase "Verifier la lisibilite\ndes images" as uc_readability
  usecase "Controler format,\ndimensions et mode" as uc_quality
  usecase "Detecter les ecarts\nenonce / reel" as uc_gap
  usecase "Afficher un echantillon\nvisuel par categorie" as uc_visual
  usecase "Synthesiser les\nobservations" as uc_summary
}

ds --> uc_inventory
ds --> uc_readability
ds --> uc_quality
ds --> uc_gap
ds --> uc_visual
ds --> uc_summary

uc_summary ..> uc_inventory : <<include>>
uc_summary ..> uc_readability : <<include>>
uc_summary ..> uc_quality : <<include>>
uc_summary ..> uc_gap : <<include>>
uc_summary ..> uc_visual : <<include>>

@enduml
